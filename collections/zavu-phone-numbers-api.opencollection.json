{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zavu Unified Messaging Layer 10DLC Phone Numbers API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phone Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get regulatory requirements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/phone-numbers/requirements",
            "params": [
              {
                "name": "countryCode",
                "value": "DE",
                "type": "query",
                "description": "Two-letter ISO country code."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of phone number (local, mobile, tollFree)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get regulatory requirements for purchasing phone numbers in a specific country. Some countries require additional documentation (addresses, identity documents) before phone numbers can be activated."
        },
        {
          "info": {
            "name": "Search available phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/phone-numbers/available",
            "params": [
              {
                "name": "countryCode",
                "value": "US",
                "type": "query",
                "description": "Two-letter ISO country code."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of phone number to search for."
              },
              {
                "name": "contains",
                "value": "",
                "type": "query",
                "description": "Search for numbers containing this string."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search for available phone numbers to purchase by country and type."
        },
        {
          "info": {
            "name": "List phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/phone-numbers",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by phone number status."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all phone numbers owned by this project."
        },
        {
          "info": {
            "name": "Purchase a phone number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/phone-numbers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Purchase an available phone number. The first US phone number is free for each team."
        },
        {
          "info": {
            "name": "Get phone number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/phone-numbers/:phoneNumberId",
            "params": [
              {
                "name": "phoneNumberId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get details of a specific phone number."
        },
        {
          "info": {
            "name": "Update phone number",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.zavu.dev/v1/phone-numbers/:phoneNumberId",
            "params": [
              {
                "name": "phoneNumberId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a phone number's name or sender assignment."
        },
        {
          "info": {
            "name": "Release phone number",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/phone-numbers/:phoneNumberId",
            "params": [
              {
                "name": "phoneNumberId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Release a phone number. The phone number must not be assigned to a sender."
        }
      ]
    }
  ],
  "bundled": true
}