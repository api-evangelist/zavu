{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zavu Unified Messaging Layer 10DLC Contacts API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/contacts",
            "params": [
              {
                "name": "phoneNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List contacts with their communication channels."
        },
        {
          "info": {
            "name": "Create contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new contact with one or more communication channels."
        },
        {
          "info": {
            "name": "Get contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/contacts/:contactId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get contact"
        },
        {
          "info": {
            "name": "Update contact",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.zavu.dev/v1/contacts/:contactId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update contact"
        },
        {
          "info": {
            "name": "Delete contact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/contacts/:contactId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Permanently delete a contact and its communication channels. Implements right-to-erasure obligations under GDPR Art. 17, Ley 19.628 (Chile) Art. 12, CCPA § 1798.105, and LGPD Art. 18.VI. The contact, its channels, and any associated agent flow sessions and conversation threads are removed. Past message records and broadcast delivery logs are retained for billing/audit but no longer reference the deleted contact."
        },
        {
          "info": {
            "name": "Get contact by phone number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/contacts/phone/:phoneNumber",
            "params": [
              {
                "name": "phoneNumber",
                "value": "",
                "type": "path",
                "description": "E.164 phone number."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get contact by phone number"
        },
        {
          "info": {
            "name": "Add channel to contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/channels",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new communication channel to an existing contact."
        },
        {
          "info": {
            "name": "Update channel",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/channels/:channelId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              },
              {
                "name": "channelId",
                "value": "",
                "type": "path",
                "description": "Channel ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a contact's channel properties."
        },
        {
          "info": {
            "name": "Remove channel from contact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/channels/:channelId",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              },
              {
                "name": "channelId",
                "value": "",
                "type": "path",
                "description": "Channel ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a communication channel from a contact. Cannot remove the last channel."
        },
        {
          "info": {
            "name": "Set channel as primary",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/channels/:channelId/primary",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              },
              {
                "name": "channelId",
                "value": "",
                "type": "path",
                "description": "Channel ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Set a channel as the primary channel for its type."
        },
        {
          "info": {
            "name": "Merge contacts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/merge",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Merge a source contact into this contact. All channels from the source contact will be moved to the target contact, and the source contact will be marked as merged."
        },
        {
          "info": {
            "name": "Dismiss merge suggestion",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/contacts/:contactId/merge-suggestion",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Dismiss the merge suggestion for a contact."
        }
      ]
    }
  ],
  "bundled": true
}