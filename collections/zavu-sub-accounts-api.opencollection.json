{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zavu Unified Messaging Layer 10DLC Sub-Accounts API",
    "version": "0.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sub-Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sub-accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/sub-accounts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List sub-accounts for this team. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Create sub-account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/sub-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new sub-account (project) with its own API key. All charges are billed to the parent team's balance. Use creditLimit to set a spending cap. The sub-account's API key is returned only in the creation response. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Get sub-account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get sub-account. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Update sub-account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update sub-account. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Deactivate sub-account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deactivate a sub-account. Remaining balance is returned to the parent team and all API keys are revoked. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Get sub-account spending",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id/balance",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get spending information for a sub-account. Returns the parent team's balance, the sub-account's total spending, and its credit limit (spending cap). Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "List sub-account API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id/api-keys",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List sub-account API keys. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Create sub-account API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id/api-keys",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create sub-account API key. Requires a parent project API key; sub-account API keys receive HTTP 403."
        },
        {
          "info": {
            "name": "Revoke sub-account API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.zavu.dev/v1/sub-accounts/:id/api-keys/:keyId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sub-account ID."
              },
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "API key ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revoke sub-account API key. Requires a parent project API key; sub-account API keys receive HTTP 403."
        }
      ]
    }
  ],
  "bundled": true
}